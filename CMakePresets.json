{
	"version": 6,
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build/${presetName}",
			"toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
			"cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": true }
		},
		{
			"name": "debug",
			"inherits": "base",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "COPY_RESOURCES": "OFF", "PROFILING": "ON", "PROFILING_ON_DEMAND": "ON" }
		},
		{
			"name": "profile",
			"inherits": "base",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "COPY_RESOURCES": "OFF", "PROFILING": "ON", "PROFILING_ON_DEMAND": "ON" }
		},
		{
			"name": "profile (full)",
			"inherits": "base",
			"binaryDir": "${sourceDir}/build/profile",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo", "COPY_RESOURCES": "OFF", "PROFILING": "ON", "PROFILING_ON_DEMAND": "OFF" }
		},
		{
			"name": "release",
			"inherits": "base",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "COPY_RESOURCES": "ON", "PROFILING": "OFF" }
		}
	],
	"buildPresets": [
		{ "name": "debug", "configurePreset": "debug" },
		{ "name": "profile", "configurePreset": "profile" },
		{ "name": "profile (full)", "configurePreset": "profile (full)" },
		{ "name": "release", "configurePreset": "release" }
	]
}